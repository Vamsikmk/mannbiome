# Application Configuration
APP_NAME=MannBiome Customer Portal API
APP_VERSION=1.0.0
APP_DESCRIPTION=API for the MannBiome Customer Portal platform with microbiome analysis and health insights

# Database Configuration
DATABASE_URL=postgresql://USERNAME:PASSWORD@your-db-host.region.rds.amazonaws.com:5432/database_name
VECTORDB_URL=postgresql://USERNAME:PASSWORD@your-db-host.region.rds.amazonaws.com:5432/vectordb

# React App API Configuration
REACT_APP_API_BASE_URL=https://your-app-runner-url.region.awsapprunner.com
# REACT_APP_API_BASE_URL=http://127.0.0.1:8001

# Database Configuration (for PatientDataInserter)
DB_HOST=your-db-host.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=database_name
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Anthropic Claude API Key for LLM recommendations
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_API_KEY_HERE

# Patient Report Upload Configuration
# Local storage path (will mirror S3 structure for easy migration)
UPLOAD_BASE_PATH=./uploads
UPLOAD_BUCKET_NAME=your-s3-bucket-name

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=false

# Environment
ENVIRONMENT=production

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "https://your-frontend-domain.com"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# AWS Configuration (for deployment)
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30

# Security
SECRET_KEY=your-application-secret-key-change-this
BCRYPT_ROUNDS=12

# External API Configuration (if applicable)
# EXTERNAL_API_URL=https://api.external-service.com
# EXTERNAL_API_KEY=your-external-api-key